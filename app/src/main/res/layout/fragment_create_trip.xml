<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/dialogbg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" >

            <ImageView
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center|top"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_round_remove_24" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/createText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="5dp"
                    android:padding="8dp"
                    android:text="Create Trip"
                    android:textAlignment="viewStart"
                    android:textColor="@color/lavender"
                    android:textSize="25dp" />

                <ImageView
                    android:id="@+id/cancelButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="250dp"
                    android:layout_marginTop="8dp"
                    android:src="@drawable/ic_baseline_clear_24" />

            </LinearLayout>
            <LinearLayout
                android:id="@+id/layoutVideo"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="10dp"
                android:textColorHint="@color/black"
                app:boxBackgroundColor="@color/white"
                android:orientation="horizontal"
                android:padding="10dp"
                android:paddingTop="10dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/textInputLayoutSearchStart"
                    app:boxStrokeColor="@color/black"
                    android:layout_width="match_parent"
                    android:background="@drawable/rounded_border"
                    android:layout_height="match_parent"
                    app:hintTextColor="@color/gray_500"
                    android:textColorHint="@color/gray_500"
                    app:boxBackgroundColor="@color/white">

                    <AutoCompleteTextView
                        android:id="@+id/autocomplete_ct_start_dest"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:drawableEnd="@drawable/baseline_add_location_24"
                        android:hint="Enter your start location"
                        android:paddingTop="5dp"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/black"
                        android:textColorHint="@color/gray_500"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>



            <LinearLayout
                android:id="@+id/layoutLive"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="10dp"
                android:textColorHint="@color/black"
                app:boxBackgroundColor="@color/white"
                android:orientation="horizontal"
                android:padding="10dp"
                android:paddingTop="10dp">


                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/textInputLayoutSearchDest"
                    app:boxStrokeColor="@color/black"
                    android:layout_width="match_parent"
                    android:background="@drawable/rounded_border"
                    android:layout_height="match_parent"
                    app:hintTextColor="@color/gray_500"
                    android:textColorHint="@color/gray_500"
                    app:boxBackgroundColor="@color/white">

                    <AutoCompleteTextView
                        android:id="@+id/autocomplete_ct_end_dest"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:drawableEnd="@drawable/baseline_add_location_24"
                        android:hint="Enter your Destination"
                        android:paddingTop="5dp"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/black"
                        android:textColorHint="@color/gray_500"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="393dp"
                android:layout_height="70dp"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/createTripDate"
                    android:layout_width="182dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="10dp"
                    android:drawableRight="@android:drawable/ic_menu_my_calendar"
                    android:drawableTint="@color/black"
                    android:hint="Date"
                    android:inputType="date"
                    android:textColorHint="@color/black"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:boxStrokeColor="@color/black"
                    app:boxBackgroundColor="@color/white"
                    android:layout_marginTop="5dp"
                    android:textColorHint="@color/black"
                    android:layout_marginRight="10dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/createTripTime"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:hint="Time"
                        android:inputType="time" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.Dense"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="10dp"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                app:boxBackgroundColor="@color/white"
                app:boxStrokeColor="@color/black"
                android:textColorHint="@color/black"
                >

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/createTripVacancy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableRight="@drawable/baseline_person_24"
                    android:hint="Vaccancy"
                    android:inputType="number" />

                <TextView
                    android:id="@+id/textView7"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_weight="1"
                    android:text="Driver Details"
                    android:textColor="@color/black"
                    android:textSize="20dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="10dp"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/black"
                    android:textColorHint="@color/black">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/createTripDriverName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Name" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="10dp"
                        app:boxBackgroundColor="@color/white"
                        app:boxStrokeColor="@color/black"
                        android:textColorHint="@color/black">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/createTripDriverNumber"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:drawableRight="@android:drawable/ic_menu_call"
                            android:drawableTint="@color/black"
                            android:hint="Phone no:" />

                        <TextView
                            android:id="@+id/textView8"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Vehicle Details"
                            android:textColor="@color/black"
                            android:textSize="20dp"
                            android:layout_marginTop="20dp"/>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:boxBackgroundColor="@color/white"
                            android:layout_marginTop="10dp"
                            android:textColorHint="@color/black"
                            app:boxStrokeColor="@color/black">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/createTripVehicleModel"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Vehicle Model" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginTop="10dp"
                                app:boxBackgroundColor="@color/white"
                                app:boxStrokeColor="@color/black"
                                android:textColorHint="@color/black">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/createTripVehicleNumber"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="Registration no:" />

                                <com.google.android.material.textfield.TextInputLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_marginTop="10dp"
                                    app:boxBackgroundColor="@color/white"
                                    app:boxStrokeColor="@color/black"
                                    android:textColorHint="@color/black">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/createTripVehicleMileage"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:hint="Mileage" />

                                    <Button
                                        android:id="@+id/createTripButton"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:layout_marginTop="20dp"
                                        android:layout_weight="1"
                                        android:backgroundTint="@color/lavender"
                                        android:text="Create Trip"


                                        app:cornerRadius="20dp" />
                                </com.google.android.material.textfield.TextInputLayout>

                                <TextView
                                    android:id="@+id/textView6"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="\n"
                                    android:textSize="34sp" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </com.google.android.material.textfield.TextInputLayout>
                    </com.google.android.material.textfield.TextInputLayout>
                </com.google.android.material.textfield.TextInputLayout>

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/textView5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="\n"
                android:textSize="34sp" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>