<?xml version="1.0" encoding="UTF-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <data>
        <variable name="frameSixVM" type="com.codrive.app.modules.framesix.data.viewmodel.FrameSixVM"/>
    </data>
    <LinearLayout android:gravity="center_horizontal"
        android:id="@+id/linearColumncard"
        android:layout_height="match_parent"
        android:layout_width="match_parent"
        android:orientation="vertical" style="@style/groupStylegray_901">
        <View
            android:background="@drawable/rectangle_bg_gray_600_radius_11"
            android:id="@+id/viewCard"
            android:layout_gravity="center_horizontal"
            android:layout_height="@dimen/_286pxv"
            android:layout_marginEnd="@dimen/_16pxh"
            android:layout_marginStart="@dimen/_16pxh"
            android:layout_marginTop="@dimen/_211pxv" android:layout_width="@dimen/_365pxh"/>
        <androidx.appcompat.widget.AppCompatButton
            android:ellipsize="end" android:gravity="center"
            android:id="@+id/btnSearch"
            android:layout_gravity="center_horizontal"
            android:layout_height="@dimen/_30pxv"
            android:layout_marginBottom="@dimen/_20pxv"
            android:layout_marginEnd="@dimen/_16pxh"
            android:layout_marginStart="@dimen/_16pxh"
            android:layout_marginTop="@dimen/_18pxv"
            android:layout_width="@dimen/_105pxh"
            android:paddingBottom="@dimen/_5pxv"
            android:paddingEnd="@dimen/_18pxh"
            android:paddingStart="@dimen/_28pxh"
            android:paddingTop="@dimen/_5pxv" android:singleLine="true"
            android:text="@string/lbl_search"
            android:textAllCaps="false" style="@style/btnSolidRounded_1" tools:text="@string/lbl_search"/>
    </LinearLayout>
</layout>
